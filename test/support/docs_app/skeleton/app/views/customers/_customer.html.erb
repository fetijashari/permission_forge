<div id="<%= dom_id customer %>">
  <div>
    <strong>Name:</strong>
    <%= customer.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= customer.email %>
  </div>

  <div>
    <strong>Phone:</strong>
    <%= customer.phone %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= customer.status %>
  </div>

  <div>
    <strong>Notes:</strong>
    <%= customer.notes %>
  </div>

  <div>
    <strong>Owner:</strong>
    <%= customer.owner_id %>
  </div>

</div>
