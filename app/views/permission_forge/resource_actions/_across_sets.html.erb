<%# One action in every Permission Set containing the resource.
    Locals: rows ([{ resource:, set:, action:, in_effect: }] from Admin::ActionAcrossSets#rows) %>
<div class="pf-listbox">
  <% rows.each do |row| %>
    <% action = row[:action] %>
    <% set = row[:set] %>
    <div class="pf-option">
      <span class="pf-option__main"><span class="pf-row pf-row--tight">
        <% if set.is_muting %><span class="pf-text-restrict" aria-hidden="true">⊘</span><% end %>
        <span class="pf-fw-600"><%= pf_record_name(set) %></span>
        <%= pf_off_badge unless row[:in_effect] %>
      </span></span>
      <%# The row's state, worded as the action page's "Right now" badge (Admin::StateLabel, kind :action). %>
      <% state = if action.nil? then :none
                 elsif set.is_muting then action.is_permitted ? :blocked : :unchanged
                 else action.is_permitted ? :permitted : :not_permitted
                 end %>
      <%= pf_level_badge(state, kind: :action) %>
    </div>
  <% end %>
</div>
