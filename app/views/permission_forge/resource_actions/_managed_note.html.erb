<%# What "managed" means — shown before an action is added to a Permission Set. %>
<%# Under :allow the first row restricts the action; under :block (the default) it opens it to the permitted. %>
<% allowed = PermissionForge.configuration.allow_unconfigured_actions? %>
<div class="pf-banner" role="note">
  <div class="pf-banner__body">
    <span class="pf-banner__title"><%= allowed ? t('.title_allowed') : t('.title_blocked') %></span>
    <span><%= allowed ? t('.body_allowed') : t('.body_blocked') %></span>
    <span>
      <%= allowed ? t('.unmanaged_allowed') : t('.unmanaged_blocked') %>
      <%= pf_setting_link('unconfigured_action_strategy') %>
    </span>
  </div>
</div>
