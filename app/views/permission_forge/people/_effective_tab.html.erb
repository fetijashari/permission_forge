<% first_name = pf_person(@person).first_name %>
<% flags = PermissionForge::Admin::EffectiveAccess::CRUD %>
<div class="pf-stack pf-stack--loose">
  <div class="pf-row pf-row--between">
    <p class="pf-text-2"><%= t('.intro', name: first_name) %></p>
    <div class="pf-legend" aria-label="<%= t('.legend') %>">
      <%# The legend words each state as the cells do (Admin::StateLabel). %>
      <% [%i[effective granted], %i[effective blocked], %i[effective none], %i[field_level masked]].each do |kind, state| %>
        <span><%= pf_state_parts(pf_state(kind, state), glyph_tag: :b, separator: ' ') %></span>
      <% end %>
    </div>
  </div>

  <% if @conditional_sets.any? %>
    <div class="pf-banner">
      <span class="pf-banner__glyph" aria-hidden="true">◷</span>
      <div class="pf-banner__body">
        <span><%= t('.conditional', sets: pf_to_sentence(@conditional_sets.map(&:name))) %></span>
      </div>
    </div>
  <% end %>

  <% if @effective.empty? %>
    <div class="pf-card"><p class="pf-empty"><%= t('permission_forge.people.access_tab.empty', name: first_name) %></p></div>
  <% else %>
    <div class="pf-split">
      <%= pf_scroll_frame('aria-label': t('.grid_label'), class: 'pf-split__main pf-card') do %>
        <div class="pf-effective" role="table" aria-label="<%= t('.grid_label') %>">
          <div class="pf-matrix__head" role="row">
            <span role="columnheader"><%= t('permission_forge.ui.resource') %></span>
            <% flags.each do |flag| %><span role="columnheader"><%= t("permission_forge.ui.flags_short.#{flag}") %></span><% end %>
            <span role="columnheader"><%= t('permission_forge.ui.records') %></span>
          </div>
          <% @effective.each do |res| %>
            <% open = @open.include?(res.name) || @why.start_with?("#{res.name}.field.", "#{res.name}.action.") %>
            <% plural = pf_resource_plural(res.name) %>
            <% region = "pf-eff-#{res.name.parameterize}" %>
            <div class="pf-effective__group">
              <div class="pf-matrix__row" role="row">
                <span role="rowheader">
                  <a href="<%= permission_forge.person_path(@person, tab: 'effective', open: (open ? @open - [res.name] : @open + [res.name])) %>"
                     class="pf-row pf-row--nowrap pf-row--top" data-pf-toggle="<%= region %>" aria-expanded="<%= open %>" aria-controls="<%= region %>">
                    <span class="pf-disclosure<%= ' pf-disclosure--open' if open %>" aria-hidden="true">▸</span>
                    <span class="pf-stack pf-stack--tight">
                      <span class="pf-fw-600 pf-text-2"><%= pf_resource_label(res.name) %></span>
                      <span class="pf-fs-12 pf-text-3"><%= t('.fields_visible', visible: res.visible_field_count, total: res.fields.size) %></span>
                    </span>
                  </a>
                </span>
                <% flags.each do |flag| %>
                  <% outcome = res.op(flag) %>
                  <% key = "#{res.name}.#{flag}" %>
                  <span role="cell">
                    <%= pf_state_cell(outcome.state, aria: "#{t("permission_forge.ui.flags_short.#{flag}")} #{plural}",
                                      href: permission_forge.person_path(@person, tab: 'effective', why: key, open: @open),
                                      why: key, current: @why == key) %>
                  </span>
                <% end %>
                <span role="cell">
                  <% key = "#{res.name}.records" %>
                  <%= link_to permission_forge.person_path(@person, tab: 'effective', why: key, open: @open), class: 'pf-state pf-state--records',
                              data: { pf_why: key }, 'aria-current': (@why == key ? 'true' : nil) do %>
                    <% if res.records == :all %><span class="pf-text-2"><%= t('permission_forge.ui.view_all') %></span>
                    <% elsif res.records == :rules %>
                      <span class="pf-text-2"><%= t('permission_forge.ui.rules_count', count: res.rules.size) %></span>
                      <% if (headline = pf_rule_headline(res.rules.map(&:rule))) %><span class="pf-fs-12 <%= pf_rule_problem(headline) ? 'pf-text-block' : 'pf-text-3' %> pf-state__summary"><%= pf_rule_summary(headline, res.name) %></span><% end %>
                    <% else %><span>–</span>
                    <% end %>
                  <% end %>
                </span>
              </div>
              <div id="<%= region %>" class="pf-effective__detail" <%= 'hidden' unless open %>>
                <% res.fields.each do |field| %>
                  <% key = "#{res.name}.field.#{field.name}" %>
                  <%= link_to permission_forge.person_path(@person, tab: 'effective', why: key, open: (@open + [res.name]).uniq),
                              class: 'pf-effective__field', data: { pf_why: key }, 'aria-current': (@why == key ? 'true' : nil) do %>
                    <span class="pf-row pf-row--tight pf-grow">
                      <% field_label = pf_field_label_for(res.name, field.name) %>
                      <% unless field_label.verbatim? %><span data-pf-host-data><%= field_label.text %></span><% end %>
                      <code class="pf-mono-key"><%= field.name %></code>
                      <% if field.virtual %><%= pf_badge(t('permission_forge.ui.badges.virtual')) %><% end %>
                    </span>
                    <%= pf_effective_field_badge(field) %>
                    <span class="pf-fs-12 <%= field.blocked_by.any? ? 'pf-text-block' : (field.unconfigured ? 'pf-text-warn' : 'pf-text-3') %>">
                      <%= render 'effective_field_source', field: field %>
                    </span>
                  <% end %>
                <% end %>
                <% if res.actions.any? %>
                  <div class="pf-row pf-mt-8">
                    <span class="pf-eyebrow"><%= t('permission_forge.ui.actions') %></span>
                    <% res.actions.each do |name, outcome| %>
                      <% key = "#{res.name}.action.#{name}" %>
                      <%= link_to permission_forge.person_path(@person, tab: 'effective', why: key, open: (@open + [res.name]).uniq),
                                  class: "pf-state pf-state--#{outcome.state} pf-action-pill", data: { pf_why: key },
                                  'aria-current': (@why == key ? 'true' : nil) do %>
                        <% state = pf_state(:effective, outcome.state) %>
                        <span aria-hidden="true"><%= state.glyph %></span> <%= pf_action_label_text(nil, name) %>
                        <span class="pf-fs-12">· <%= state.word %></span>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <aside class="pf-split__side pf-card" aria-live="polite" aria-label="<%= t('.why_label') %>">
        <div class="pf-why" data-pf-why-empty <%= 'hidden' if @why.present? %>>
          <span class="pf-eyebrow"><%= t('.why') %></span>
          <p class="pf-fs-13 pf-text-2"><%= t('.why_empty') %></p>
        </div>
        <%= render 'effective_why', resources: @effective %>
      </aside>
    </div>
  <% end %>
</div>
