<%# Every explanation is rendered; JS reveals one on click, the server marks ?why= active. %>
<% resources.each do |res| %>
  <% plural = pf_resource_plural(res.name) %>
  <% PermissionForge::Admin::EffectiveAccess::CRUD.each do |flag| %>
    <% outcome = res.op(flag) %>
    <% flag_label = t("permission_forge.ui.flags_short.#{flag}") %>
    <%= render 'why_item', key: "#{res.name}.#{flag}", title: t('.flag_title', flag: flag_label, resource: plural),
               badge: pf_state_cell(outcome.state, aria: t('.flag_title', flag: flag_label, resource: plural)),
               reasons: outcome.granted_by.map { |ps| ['✓', pf_t_markup(set: pf_chain_set_name(ps, res.name)) { |held| t('.flag_granted', **held, flag: flag_label) }, ps] } +
                        outcome.blocked_by.map { |ps| ['⊘', t('.flag_muted', set: pf_record_name(ps), flag: flag_label), ps] } +
                        (outcome.granted_by.empty? ? [['–', t('.flag_none', flag: flag_label), nil]] : []),
               note: outcome.blocked? ? t('.note_muting') : t('.note_add_up') %>
  <% end %>

  <% records_reasons = case res.records
                       when :all then res.op(:view_all).granted_by.map { |ps| ['✓', pf_t_markup(set: pf_chain_set_name(ps, res.name)) { |held| t('.view_all_from', **held) }, ps] }
                       when :rules then res.rules.map { |src| [pf_rule_glyph(src.rule), pf_rule_text(src.rule, res.name), src.permission_set] }.presence || [['✓', t('.no_rules'), nil]]
                       else [['–', t('.records_none'), nil]]
                       end %>
  <%= render 'why_item', key: "#{res.name}.records", title: t('.records_title', resource: plural),
             badge: content_tag(:span, res.records == :all ? t('permission_forge.ui.view_all') : t('permission_forge.ui.rules_count', count: res.rules.size), class: 'pf-pill'),
             reasons: records_reasons,
             note: res.records == :rules ? t('.note_rules') : nil %>

  <% res.fields.each do |field| %>
    <% field_label = pf_field_label_text(res.name, field.name) %>
    <%# A grant is the deciding entry's: an STI base's (decided_by) or the resource's own (B#35). %>
    <% reasons = field.grants.map { |src| ['✓', pf_field_source_sentence(src, set_name: pf_chain_set_name(src.permission_set, res.name, field.decided_by || res.name)), src.permission_set] } %>
    <% reasons += field.mutes.map { |src| ['⊘', pf_field_source_sentence(src), src.permission_set] } %>
    <% reasons << ['⚠', t('.field_unconfigured', behaviour: t("permission_forge.ui.unconfigured.#{PermissionForge.configuration.unconfigured_field_strategy}", default: t('permission_forge.ui.unconfigured.block'))), nil] if field.unconfigured %>
    <% reasons << ['–', t('.field_capped'), nil] if field.capped %>
    <% reasons << ['◇', t('.field_virtual'), nil] if field.implicit %>
    <% reasons << ['↳', t('.field_variant', base: field.variant_of), nil] if field.variant_of %>
    <% chain = pf_field_chain_reason(field) %>
    <% reasons << [*chain, nil] if chain %>
    <% reasons << ['–', t('.field_none'), nil] if reasons.empty? %>
    <%= render 'why_item', key: "#{res.name}.field.#{field.name}", title: t('.field_title', resource: pf_resource_label(res.name), field: field_label),
               badge: pf_effective_field_badge(field, sample: true),
               reasons: reasons,
               note: field.blocked_by.any? ? t('.note_muting') : t('.note_fields') %>
  <% end %>

  <% res.actions.each do |name, outcome| %>
    <% action_label = pf_action_label_text(nil, name) %>
    <%= render 'why_item', key: "#{res.name}.action.#{name}", title: t('.action_title', action: action_label, resource: plural),
               badge: pf_state_cell(outcome.state, aria: action_label),
               reasons: outcome.granted_by.map { |ps| ['✓', pf_t_markup(set: pf_chain_set_name(ps, res.name)) { |held| t('.action_granted', **held) }, ps] } +
                        outcome.blocked_by.map { |ps| ['⊘', t('.action_muted', set: pf_record_name(ps)), ps] } +
                        (outcome.granted_by.empty? ? [['–', t('.action_none'), nil]] : []),
               note: outcome.blocked? ? t('.note_muting') : t('.note_add_up') %>
  <% end %>
<% end %>
