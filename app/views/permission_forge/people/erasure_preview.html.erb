<% label = pf_person(@person) %>
<% content_for :pf_title, t('.title') %>
<%= pf_dialog_frame({ title: t('.title_for', name: label.name), danger: true, eyebrow: t('.eyebrow'),
                     breadcrumb: pf_breadcrumb([t('permission_forge.nav.people'), permission_forge.people_path], [label.name, permission_forge.person_path(@person)], t('.title')) }) do %>
  <p class="pf-text-2"><%= t('.intro') %></p>
  <div class="pf-dryrun">
    <span class="pf-eyebrow"><%= t('permission_forge.ui.dry_run') %></span>
    <span class="pf-fs-13">
      <%= t('.counts', assignments: t('.assignments', count: @preview[:assignments_count].to_i),
                       groups: t('.groups', count: @preview[:group_assignments_count].to_i)) %>
    </span>
    <% if @preview[:permission_sets].present? %>
      <ul class="pf-confirm__list"><% @preview[:permission_sets].each do |name| %><li><%= name %></li><% end %></ul>
    <% end %>
    <span class="pf-fs-12 pf-text-3"><%= t('.untouched') %></span>
  </div>
  <%= form_with url: permission_forge.erasure_person_path(@person), method: :post, class: 'pf-stack' do %>
    <label class="pf-label" for="pf-erase-confirm"><%= t('.type_to_confirm_html', name: content_tag(:strong, label.name)) %></label>
    <input id="pf-erase-confirm" class="pf-input" type="text" name="confirmation" autocomplete="off"
           data-pf-confirm-match="<%= label.name %>" <%= pf_attrs_when(@confirmation_error, aria: { invalid: true, describedby: 'pf-erase-error' }) %>>
    <% if @confirmation_error %><p id="pf-erase-error" class="pf-error" role="alert"><%= t('.mismatch') %></p><% end %>
    <%= render 'permission_forge/shared/reason_field', id: 'pf-erase-reason', value: params[:reason] %>
    <div class="pf-actions pf-row--right">
      <%= link_to t('permission_forge.ui.cancel'), permission_forge.person_path(@person), class: 'pf-btn', data: { pf_close: true } %>
      <button type="submit" class="pf-btn pf-btn--danger-solid" data-pf-confirm-target><%= t('.confirm') %></button>
    </div>
  <% end %>
<% end %>
