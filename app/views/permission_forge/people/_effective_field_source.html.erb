<%# Locals: field (EffectiveAccess::FieldOutcome), res_name (the Resource the row is about). %>
<% if field.blocked_by.any? %>
  <%= t('.muted_by', set: pf_to_sentence(field.blocked_by.map { |set| pf_record_name(set) })) %>
<% elsif field.unconfigured %>
  <%= t('.unconfigured', state: pf_state(:field_level, :none).word, behaviour: t("permission_forge.ui.unconfigured.#{PermissionForge.configuration.unconfigured_field_strategy}", default: t('permission_forge.ui.unconfigured.block'))) %>
<% elsif field.granted_by.any? %>
  <%# The deciding entry's set, named with its Resource when it holds more than one of the chain (B#35). %>
  <%= pf_t_markup(set: pf_chain_set_name(field.granted_by.first, res_name, field.decided_by || res_name)) { |held| t('.from', **held) } %><%= t('.and_more', count: field.granted_by.size - 1) if field.granted_by.size > 1 %>
<% elsif field.implicit %>
  <%= t('.virtual') %>
<% else %>
  <%= t('.none') %>
<% end %>
