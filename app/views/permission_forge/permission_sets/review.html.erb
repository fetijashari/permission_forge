<% set = @permission_set %>
<% content_for :pf_title, t('.title') %>
<%= pf_dialog_frame({ title: t('.title', count: @changes.size), role: 'dialog', wide: true,
                     breadcrumb: pf_breadcrumb([t('permission_forge.nav.permission_sets'), permission_forge.permission_sets_path],
                                               [set.name, permission_forge.permission_set_path(set)], t('.crumb')) }) do %>
  <p class="pf-text-2">
    <%= @people_count.positive? ? t('.body', people: pf_people_text(@people_count)) : t('.body_nobody') %>
  </p>
  <ul class="pf-confirm__list pf-change-list">
    <% @changes.each do |change| %><li><span><%= pf_change_description(change) %></span></li><% end %>
  </ul>
  <% refused = @change_set.refused %>
  <% if refused.any? %>
    <div class="pf-banner pf-banner--warn">
      <span class="pf-banner__glyph" aria-hidden="true">⚠</span>
      <div class="pf-banner__body">
        <b><%= t('.not_applied') %></b>
        <ul class="pf-change-list"><% refused.each do |refusal| %><li><%= pf_refusal_description(refusal) %></li><% end %></ul>
      </div>
    </div>
  <% end %>
  <% if @impact_people.any? %>
    <p class="pf-fs-13 pf-text-3">
      <%= t('.affected', names: (@impact_people.map { |u| pf_person_name(u) } + (@people_count > 3 ? [t('permission_forge.permission_sets.show.and_more', count: @people_count - 3)] : [])).to_sentence) %>
    </p>
  <% end %>
  <%= form_with url: permission_forge.apply_permission_set_path(set), method: :patch, class: 'pf-confirm-form' do %>
    <%= render 'permission_forge/shared/reason_field' %>
    <div class="pf-actions pf-row--right">
      <input type="hidden" name="return_to" value="<%= params[:return_to] %>">
      <%= pf_hidden_params('pf', params[:pf]) %>
      <%= link_to t('.back'), pf_back_or(permission_forge.permission_set_path(set)), class: 'pf-btn', data: { pf_close: true } %>
      <button type="submit" class="pf-btn pf-btn--primary"><%= t('.save') %></button>
    </div>
  <% end %>
<% end %>
