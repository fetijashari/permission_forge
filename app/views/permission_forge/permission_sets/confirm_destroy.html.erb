<% set = @permission_set %>
<% content_for :pf_title, t('.title', name: set.name) %>
<%= pf_dialog_frame({ title: t('.title', name: set.name), danger: true,
                     breadcrumb: pf_breadcrumb([t('permission_forge.nav.permission_sets'), permission_forge.permission_sets_path],
                                               [set.name, permission_forge.permission_set_path(set)], t('.crumb')) }) do %>
  <p class="pf-text-2">
    <% if @people_count.zero? %>
      <%= t('.body_nobody') %>
    <% elsif set.is_muting %>
      <%= t('.body_muting', people: pf_people_text(@people_count)) %>
    <% else %>
      <%= t('.body', people: pf_people_text(@people_count), resources: @lost.any? ? pf_to_sentence(@lost) : '—') %>
    <% end %>
    <%= t('.irreversible') %>
  </p>
  <%= form_with url: permission_forge.permission_set_path(set), method: :delete, class: 'pf-confirm-form' do %>
    <%= render 'permission_forge/shared/reason_field' %>
    <div class="pf-actions pf-row--right">
      <%= link_to t('permission_forge.ui.cancel'), permission_forge.permission_set_path(set), class: 'pf-btn', data: { pf_close: true } %>
      <button type="submit" class="pf-btn pf-btn--danger-solid"><%= t('.confirm') %></button>
    </div>
  <% end %>
<% end %>
