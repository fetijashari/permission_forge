<% set = @permission_set %>
<% locked = pf_locked?(set) %>
<% content_for :pf_title, pf_record_name(set) %>
<%= pf_breadcrumb([t('permission_forge.nav.permission_sets'), permission_forge.permission_sets_path], pf_record_name(set)) %>

<%= render 'permission_forge/shared/mode_banners', record: set, muting: set.is_muting,
           duplicate_path: permission_forge.duplicate_permission_set_path(set) %>

<%# The batched-edit form. Inputs anywhere on the page join it via form="pf-set-form". %>
<%= form_with url: permission_forge.review_permission_set_path(set), method: :post, id: 'pf-set-form',
              data: { pf_track: 'pf-set-savebar', pf_review: true } do %>
  <input type="hidden" name="return_to" value="<%= request.fullpath %>">
<% end %>

<%= render 'header', set: set, locked: locked %>

<p class="pf-impact">
  <span class="pf-dot" aria-hidden="true"></span>
  <% if @people_count.zero? %>
    <%= t('.impact_none') %>
  <% else %>
    <%= t('.impact', people: pf_people_text(@people_count),
                     names: pf_to_sentence(@impact_people.map { |u| pf_person_name(u) } + (@people_count > 3 ? [t('.and_more', count: @people_count - 3)] : []))) %>
  <% end %>
</p>

<nav class="pf-tabs" role="tablist" aria-label="<%= t('.tabs_label') %>">
  <%= pf_tab t('.tabs.resources'), permission_forge.permission_set_path(set), selected: @tab == 'resources', count: @resources.size %>
  <%= pf_tab t('.tabs.assignments'), permission_forge.permission_set_path(set, tab: 'assignments'), selected: @tab == 'assignments', count: @assignment_count %>
  <%= pf_tab t('.tabs.conditions') + (set.conditional? ? " (#{t('.on')})" : ''), permission_forge.permission_set_path(set, tab: 'conditions'), selected: @tab == 'conditions' %>
  <%= pf_tab t('.tabs.audit'), permission_forge.permission_set_path(set, tab: 'audit'), selected: @tab == 'audit' %>
</nav>

<div role="tabpanel">
  <%= render "#{@tab}_tab", set: set, locked: locked %>
</div>

<% unless locked %>
  <%# Only the Resources tab edits through the savebar; elsewhere it serves the header alone. %>
  <%= render 'permission_forge/shared/savebar', id: 'pf-set-savebar', form: 'pf-set-form', people: @people_count,
                                                quiet: @tab != 'resources' %>
<% end %>

<%= pf_tech_details(set, extras: { is_muting: set.is_muting }) do %>
  <% unless locked %>
    <div>
      <%= pf_modal_link(set.is_muting ? t('.switch_to_granting') : t('.switch_to_muting'),
                        permission_forge.switch_mode_permission_set_path(set), class: 'pf-btn pf-btn--danger pf-btn--xs') %>
    </div>
  <% end %>
<% end %>
<%= pf_audit_footer(set) %>
