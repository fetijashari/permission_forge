<%# The families or Resources of a set (Admin::SetOverview); each link opens the next view in place on the list. %>
<div class="pf-overview">
  <% if overview.total.zero? %>
    <p class="pf-text-3"><%= t('.empty') %></p>
  <% elsif overview.families.empty? %>
    <p class="pf-text-3"><%= t('.none_match') %>
      <%= pf_overview_link set, t('.show_all', count: overview.total), { view: 'resources' } %></p>
  <% elsif overview.groups? %>
    <p class="pf-fs-12 pf-text-3"><%= t('.groups_hint') %></p>
    <ul class="pf-overview__families">
      <% overview.families.each do |family| %>
        <li>
          <%= pf_overview_link set, safe_join([pf_family_name(family), content_tag(:span, family.entries.size, class: 'pf-family__count'),
                                               pf_overview_marks(family)].compact, ' '),
                               { view: 'resources', only: family.key }, class: 'pf-family' %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="pf-overview__legend pf-fs-12 pf-text-3">
      <span><%= safe_join(PermissionForge::SetSummariesHelper::ALL_FLAGS.map { |flag| "#{pf_flag_initial(flag)} #{t("permission_forge.ui.flags_short.#{flag}")}" }, ' · ') %></span>
      <span><%= overview.muting? ? t('.legend_muting') : t('.legend') %></span>
      <% if overview.filtered? %>
        <% only = overview.only %>
        <span class="pf-text-2">
          <% if only == PermissionForge::Admin::SetOverview::NARROWED %>
            <%= t('.only_narrowed') %>
          <% elsif only == PermissionForge::Admin::SetOverview::VIEW_ALL %>
            <%= t('.only_view_all') %>
          <% else %>
            <%= pf_t_markup(family: pf_family_name(overview.families.first)) { |held| t('.only_family', **held) } %>
          <% end %>
        </span>
        <%= pf_overview_link set, t('.show_all', count: overview.total), { view: 'resources' } %>
      <% end %>
    </p>
    <div class="pf-overview__cols">
      <% overview.families.each_with_index do |family, index| %>
        <% heading = "pf-overview-#{set.id}-#{index}" %>
        <section class="pf-overview__family" aria-labelledby="<%= heading %>">
          <%= pf_section_heading(safe_join([pf_family_name(family), content_tag(:span, " · #{family.entries.size}", class: 'pf-text-3')]), id: heading, in_page: true) %>
          <ul class="pf-overview__list">
            <% family.entries.each do |entry| %>
              <li class="pf-overview__res<%= ' pf-overview__res--narrowed' if entry.narrowed? %>">
                <span class="pf-overview__name">
                  <%= pf_overview_resource_link(set, entry, family) %>
                  <%= pf_off_badge unless entry.active %>
                  <%= pf_overview_marks(entry) %>
                </span>
                <%= pf_flag_strip(entry.flags, muting: entry.muting) %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
