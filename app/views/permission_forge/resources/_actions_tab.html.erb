<%# Actions of a Resource. With controller_action_discovery on, each row also
    shows where the action runs, whether that controller is guarded and what
    the saved configuration means right now; the app's controller actions
    without a row are listed and can be added (review → apply). %>
<% rows = @action_rows %>
<% discovery = rows.discovery? %>
<% discovered = rows.discovered_rows %>
<% partials = 'permission_forge/resource_actions' %>
<div class="pf-stack pf-stack--loose">
  <p class="pf-fs-13 pf-text-2"><%= muting ? t('.intro_muting') : t('.intro') %></p>
  <% if discovery %>
    <%= render "#{partials}/managed_note" %>
    <% unless rows.any_guarded? %>
      <div class="pf-banner pf-banner--warn" role="note">
        <span class="pf-banner__glyph" aria-hidden="true">⚠</span>
        <div class="pf-banner__body">
          <span class="pf-banner__title"><%= t('.no_guard_title') %></span>
          <span><%= t('.no_guard_body_html', guard: content_tag(:code, 'PermissionForge::Concerns::ControllerActionGuard')) %></span>
        </div>
      </div>
    <% end %>
  <% end %>
  <div class="pf-card">
    <% rows.configured_rows.each do |row| %>
      <% action = row.action %>
      <% action_locked = locked %>
      <div class="pf-card__row">
        <div class="pf-stack pf-stack--tight pf-grow">
          <span class="pf-row pf-row--tight">
            <b><%= row.label %></b>
            <code class="pf-mono-key"><%= row.name %></code>
            <%= pf_off_badge unless action.is_active %>
            <% if row.unlinked %><%= pf_badge("– #{t('.unlinked')}", title: t('.unlinked_title')) %><% end %>
          </span>
          <% if action.description.present? %><span class="pf-fs-13 pf-text-2"><%= action.description %></span><% end %>
          <% if discovery %>
            <%= render "#{partials}/endpoints", endpoints: row.endpoints unless row.unlinked %>
            <%= render "#{partials}/effect", row: row, muting: muting %>
          <% end %>
        </div>
        <div class="pf-row pf-row--nowrap">
          <%= render 'permission_forge/shared/crud_cell', name: "pf[actions][#{action.id}][is_permitted]", flag: 'is_permitted',
                     checked: action.is_permitted, muting: muting, locked: action_locked, form: 'pf-res-form',
                     aria: row.label %>
        </div>
        <%= pf_modal_link t('permission_forge.resources.fields_tab.details'),
                          permission_forge.permission_set_resource_action_path(set, resource.name, action),
                          kind: 'drawer', class: 'pf-btn pf-btn--ghost pf-btn--xs' %>
      </div>
    <% end %>
    <% discovered.each do |row| %>
      <%# A controller action of the app with no row in this set yet. %>
      <div class="pf-card__row">
        <div class="pf-stack pf-stack--tight pf-grow">
          <span class="pf-row pf-row--tight">
            <b><%= row.label %></b>
            <code class="pf-mono-key"><%= row.name %></code>
            <%= pf_badge(pf_state(:action, :none).word, variant: :unconfigured) %>
          </span>
          <%= render "#{partials}/endpoints", endpoints: row.endpoints %>
          <%= render "#{partials}/effect", row: row, muting: muting %>
        </div>
        <% unless locked %>
          <div class="pf-row pf-row--nowrap">
            <label class="pf-sr-only" for="pf-new-action-<%= row.name %>"><%= t('.add_aria', action: row.label) %></label>
            <%= render "#{partials}/add_select", id: "pf-new-action-#{row.name}", muting: muting,
                       name: "pf[new_actions][#{resource.id}][#{row.name}][is_permitted]" %>
          </div>
          <%= pf_modal_link t('permission_forge.resources.fields_tab.details'),
                            permission_forge.new_permission_set_resource_action_path(set, resource.name, key: row.name),
                            kind: 'drawer', class: 'pf-btn pf-btn--ghost pf-btn--xs', 'aria-label': t('.details_aria', action: row.label) %>
        <% end %>
      </div>
    <% end %>
    <% if rows.rows.empty? %><p class="pf-empty"><%= discovery ? t('.empty_discovery') : t('.empty') %></p><% end %>
    <% unless locked %>
      <div class="pf-card__footer">
        <%= pf_modal_link "+ #{t('.add')}", permission_forge.new_permission_set_resource_action_path(set, resource.name), kind: 'drawer', class: 'pf-btn pf-btn--sm' %>
        <% if discovered.any? %>
          <%# Adds every discovered action at once; a row's own choice wins. %>
          <input type="hidden" name="pf[bulk_actions][resource_id]" value="<%= resource.id %>" form="pf-res-form">
          <label class="pf-fs-13 pf-ml-auto" for="pf-bulk-actions"><%= t('.bulk_label', count: discovered.size) %></label>
          <%= render "#{partials}/add_select", id: 'pf-bulk-actions', muting: muting, name: 'pf[bulk_actions][is_permitted]' %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
