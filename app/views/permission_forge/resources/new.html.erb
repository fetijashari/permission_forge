<% set = @permission_set %>
<% content_for :pf_title, t('.title') %>
<% back = permission_forge.permission_set_path(set) %>
<%= pf_dialog_frame({ title: t('.title'), role: 'dialog', wide: true,
                     breadcrumb: pf_breadcrumb([t('permission_forge.nav.permission_sets'), permission_forge.permission_sets_path], [set.name, back], t('.title')) }) do %>
  <p class="pf-text-2"><%= t('.intro', app: pf_default_app_name || t('.the_app')) %></p>
  <%= form_with url: permission_forge.permission_set_resources_path(set), method: :post, class: 'pf-stack pf-stack--loose' do %>
    <div class="pf-row pf-row--nowrap">
      <label class="pf-sr-only" for="pf-model-q"><%= t('.search') %></label>
      <input id="pf-model-q" class="pf-input" type="search" name="q" value="<%= params[:q] %>" placeholder="<%= t('.search') %>"
             autocomplete="off" data-pf-live="pf-model-list" data-pf-live-url="<%= permission_forge.new_permission_set_resource_path(set) %>">
      <button type="submit" class="pf-btn pf-btn--sm" formmethod="get" formaction="<%= permission_forge.new_permission_set_resource_path(set) %>"><%= t('permission_forge.ui.search') %></button>
    </div>
    <div id="pf-model-list" class="pf-listbox pf-listbox--short">
      <div class="pf-listbox__scroll" role="radiogroup" aria-label="<%= t('.models') %>">
        <% if @shown.empty? %><p class="pf-option pf-text-3"><%= t('.no_models') %></p><% end %>
        <% @shown.each do |model| %>
          <% taken = @existing.include?(model.name) %>
          <% cols = model.managed_column_names %>
          <% sens = cols.count { |c| @sensitive.sensitive?(c) } %>
          <label class="pf-option">
            <input type="radio" name="model_name" value="<%= model.name %>" <%= 'checked' if @selected == model.name %> <%= 'disabled' if taken %> required>
            <span class="pf-option__main">
              <span class="pf-row pf-row--tight"><span class="pf-fw-600"><%= model.label %></span><code class="pf-mono-key"><%= model.name %></code></span>
              <span class="pf-fs-12 pf-text-3"><%= [t('.columns', count: cols.size), (t('.sensitive', count: sens) if sens.positive?)].compact.join(' · ') %></span>
            </span>
            <% if taken %><span class="pf-option__aside"><%= t('.already') %></span><% end %>
          </label>
        <% end %>
      </div>
    </div>
    <% if @error %><p class="pf-error" role="alert"><%= @error %></p><% end %>

    <fieldset class="pf-stack">
      <legend class="pf-label"><%= t('.start_from') %></legend>
      <div class="pf-choices" role="radiogroup">
        <% @presets.each do |preset| %>
          <label class="pf-choice<%= ' pf-choice--muting' if set.is_muting %>">
            <input type="radio" name="preset" value="<%= preset %>" <%= 'checked' if @preset == preset %>>
            <span class="pf-choice__box">
              <span class="pf-choice__title"><%= t(".presets.#{preset}.title") %></span>
              <span class="pf-choice__desc"><%= t(".presets.#{preset}.desc") %></span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>
    <% unless set.is_muting %>
      <p class="pf-hint"><%= PermissionForge.configuration.gdpr_defaults ? t('.note_gdpr') : t('.note') %> <%= pf_setting_link('gdpr_defaults') %></p>
    <% end %>
    <%= render 'permission_forge/shared/reason_field', id: 'pf-resource-reason', value: params[:reason] %>
    <div class="pf-actions pf-row--right">
      <%= link_to t('permission_forge.ui.cancel'), back, class: 'pf-btn', data: { pf_close: true } %>
      <button type="submit" class="pf-btn pf-btn--primary"><%= t('.add') %></button>
    </div>
  <% end %>
<% end %>
