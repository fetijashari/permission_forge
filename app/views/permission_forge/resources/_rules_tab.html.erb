<% scoping = PermissionForge.configuration.auto_query_scoping.to_s %>
<div class="pf-stack pf-stack--loose">
  <% unenforced = scoping == 'filter_only' ? @rules.any? { |r| r.is_active && r.join_rule? } : @rules.any?(&:is_active) %>
  <% if muting %>
    <p class="pf-banner"><%= t('.muting') %></p>
  <% elsif unenforced && !resource.view_all %>
    <div class="pf-banner pf-banner--warn" role="note"><span class="pf-banner__glyph" aria-hidden="true">⚠</span>
      <div class="pf-banner__body"><span><%= scoping == 'filter_only' ? t('.join_rules_warning') : t('.scoping_off_warning') %>
        <%= pf_setting_link('auto_query_scoping', t('permission_forge.ui.setting')) %></span></div></div>
  <% else %>
    <p class="pf-fs-13 pf-text-2">
      <%= scoping == 'filter_only' ? t('.scoping_on') : t('.scoping_off') %>
      <%= pf_setting_link('auto_query_scoping', t('permission_forge.ui.setting')) %>
    </p>
  <% end %>
  <% @rules.each do |rule| %>
    <% ignored = resource.view_all && rule.is_active %>
    <% rule_locked = locked || pf_locked_record?(rule) %>
    <div class="pf-rule<%= ' pf-rule--off' unless rule.is_active %>">
      <div class="pf-row">
        <b><%= rule.name %></b>
        <%= pf_off_badge unless rule.is_active %>
        <% if ignored %><%= pf_badge("⚠ #{resource.modify_all ? t('.ignored_both') : t('.ignored')}", variant: :warn) %><% end %>
        <%= pf_lock_badge if pf_locked_record?(rule) %>
        <% unless rule_locked %>
          <span class="pf-actions pf-ml-auto">
            <%= form_with url: permission_forge.toggle_permission_set_resource_rule_path(set, resource.name, rule),
                          method: :patch, class: 'pf-reason-form' do %>
              <button type="submit" class="pf-btn pf-btn--ghost pf-btn--xs"><%= rule.is_active ? t('.turn_off') : t('.turn_on') %></button>
              <%= render 'permission_forge/shared/reason_field', compact: true, id: "pf-rule-toggle-reason-#{rule.id}" %>
            <% end %>
            <%= pf_modal_link t('permission_forge.ui.edit'), permission_forge.edit_permission_set_resource_rule_path(set, resource.name, rule),
                              kind: 'drawer', class: 'pf-btn pf-btn--xs' %>
            <%= pf_modal_link t('permission_forge.ui.remove'), permission_forge.delete_permission_set_resource_rule_path(set, resource.name, rule),
                              class: 'pf-btn pf-btn--ghost-danger' %>
          </span>
        <% end %>
      </div>
      <%= pf_rule_sentence(rule, resource.name) %>
      <div class="pf-rule__meta">
        <span><%= rule.join_rule? ? t('.join_rule') : t('.filter_rule', applies: (scoping == 'filter_only' ? t('.all_queries') : t('.scoped_lookups'))) %></span>
        <% if rule.failure_message.present? %><span><%= t('.blocked_message', message: rule.failure_message) %></span><% end %>
      </div>
      <%= pf_audit_footer(rule) %>
    </div>
  <% end %>
  <% if @rules.empty? %>
    <p class="pf-card pf-empty">
      <%= muting ? t('.empty_muting') : (resource.view_all ? t('.empty_view_all') : t('.empty', resources: pf_resource_plural(resource.name))) %>
    </p>
  <% end %>
  <% unless locked || muting %>
    <div><%= pf_modal_link "+ #{t('.add')}", permission_forge.new_permission_set_resource_rule_path(set, resource.name), kind: 'drawer', class: 'pf-btn pf-btn--sm' %></div>
  <% end %>
</div>
