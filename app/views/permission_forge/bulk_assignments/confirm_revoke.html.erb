<% set = @permission_set %>
<% back = permission_forge.permission_set_path(set, tab: 'assignments') %>
<% content_for :pf_title, t('.title', count: @people.size, set: set.name) %>
<%= pf_dialog_frame({ title: t('.title', count: @people.size, set: set.name), danger: true,
                     breadcrumb: pf_breadcrumb([t('permission_forge.nav.permission_sets'), permission_forge.permission_sets_path], [set.name, back], t('.crumb')) }) do %>
  <% if @people.empty? %>
    <p class="pf-text-2"><%= t('.none') %></p>
    <div class="pf-actions pf-row--right"><%= link_to t('permission_forge.ui.close'), back, class: 'pf-btn', data: { pf_close: true } %></div>
  <% else %>
    <p class="pf-text-2"><%= t('.body') %></p>
    <ul class="pf-confirm__list"><% @people.each do |u| %><li><%= pf_person_name(u) %></li><% end %></ul>
    <%= form_with url: permission_forge.revoke_permission_set_bulk_assignment_path(set), method: :delete, class: 'pf-confirm-form' do %>
      <%= render 'permission_forge/shared/reason_field' %>
      <div class="pf-actions pf-row--right">
        <% @people.each do |u| %><input type="hidden" name="user_ids[]" value="<%= u.id %>"><% end %>
        <%= link_to t('permission_forge.ui.cancel'), back, class: 'pf-btn', data: { pf_close: true } %>
        <button type="submit" class="pf-btn pf-btn--danger-solid"><%= t('.confirm', count: @people.size) %></button>
      </div>
    <% end %>
  <% end %>
<% end %>
