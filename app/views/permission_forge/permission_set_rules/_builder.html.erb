<% form = @form %>
<% set = @permission_set %>
<% resource = @resource %>
<% back = permission_forge.permission_set_resource_path(set, resource.name, tab: 'rules') %>
<% builder = rule_builder %>
<% errors = builder.errors %>
<% refresh = permission_forge.refresh_permission_set_resource_rules_path(set, resource.name) %>
<%= form_with url: url, method: method, scope: :rule do %>
  <% if @rule&.persisted? %><input type="hidden" name="rule_id" value="<%= @rule.id %>"><% end %>
  <%# The form's default button. Without it, Enter in a text input submits through the refresh
      button below: the builder is re-rendered on its own page and the rule is not saved. %>
  <button type="submit" class="pf-sr-only" tabindex="-1" aria-hidden="true"><%= t('.save') %></button>
  <%# Hidden button used to re-render the builder after shape-changing selects. %>
  <button type="submit" formaction="<%= refresh %>" formmethod="post" name="_method" value="post" hidden data-pf-refresh-button><%= t('.update_form') %></button>
  <% footer = capture do %>
    <span class="pf-sheet__footer-note">
      <% builder.error_codes.each do |code| %><span class="pf-error" role="alert"><%= t(".errors.#{code}") %></span> <% end %>
      <% builder.model_errors.each do |msg| %><span class="pf-error" role="alert"><%= msg %></span> <% end %>
    </span>
    <%= link_to t('permission_forge.ui.cancel'), back, class: 'pf-btn', data: { pf_close: true } %>
    <button type="submit" class="pf-btn pf-btn--primary"><%= t('.save') %></button>
  <% end %>
  <%= pf_sheet_frame({ title: title, subtitle: set.name, close_path: back, footer: footer,
                       breadcrumb: pf_breadcrumb([t('permission_forge.nav.permission_sets'), permission_forge.permission_sets_path],
                                                 [set.name, permission_forge.permission_set_path(set)], [pf_resource_label(resource), back], title) }) do %>
    <% if (problem = builder.problem) %>
      <div class="pf-banner pf-banner--block" role="note"><span class="pf-banner__glyph pf-text-block" aria-hidden="true">⊘</span>
        <div class="pf-banner__body"><span class="pf-banner__title"><%= t('.problem_title') %></span>
          <span><%= pf_rule_problem_text(problem) %><% if (written = builder.written_field) %> · <code class="pf-mono-key"><%= written %></code><% end %></span>
          <span><%= t(".problem_fixes.#{problem.remedy}") %></span></div></div>
    <% end %>
    <% if builder.ignored_warning? %>
      <div class="pf-banner pf-banner--warn"><span class="pf-banner__glyph" aria-hidden="true">⚠</span>
        <div class="pf-banner__body"><span><%= t('.ignored_warning') %></span></div></div>
    <% end %>

    <%# 1. Name %>
    <div class="pf-field">
      <label class="pf-label" for="pf-rule-name">1. <%= t('.name') %></label>
      <input id="pf-rule-name" class="pf-input" type="text" name="rule[name]" value="<%= form.name %>" placeholder="<%= t('.name_placeholder') %>"
             <%= pf_attrs_when(errors[:name], aria: { invalid: true }) %>>
    </div>

    <%# 2. Field (with relationship path) %>
    <div class="pf-stack">
      <span class="pf-label">2. <%= t('.field') %></span>
      <div class="pf-builder-path">
        <span class="pf-token"><%= pf_resource_plural(resource.name) %></span>
        <% builder.steps.each_with_index do |(model, assoc), i| %>
          <span aria-hidden="true">›</span>
          <label class="pf-sr-only" for="pf-rule-path-<%= i %>"><%= t('.relationship') %></label>
          <% broken = builder.broken_step(i) %>
          <select id="pf-rule-path-<%= i %>" name="rule[path][]" class="pf-select pf-select--sm pf-select--rel" data-pf-refresh
                  <%= pf_attrs_when(broken, aria: { invalid: true }) %>>
            <% if broken %><option value="<%= broken %>" selected><%= t('.pick_relationship') %></option><% end %>
            <% model.associations.each do |a| %>
              <option value="<%= a.name %>" <%= 'selected' if assoc&.name == a.name %> data-pf-host-data><%= pf_field_label_text(model, a.name) %></option>
            <% end %>
          </select>
          <button type="submit" formaction="<%= refresh %>" name="rule[remove_step]" value="<%= i %>" class="pf-btn pf-btn--ghost pf-btn--xs"
                  aria-label="<%= t('.remove_step') %>">×</button>
        <% end %>
        <span aria-hidden="true">›</span>
        <label class="pf-sr-only" for="pf-rule-field"><%= t('.field') %></label>
        <select id="pf-rule-field" name="rule[field_name]" class="pf-select pf-select--sm" data-pf-refresh <%= pf_attrs_when(errors[:field], aria: { invalid: true }) %>>
          <option value=""><%= t('.pick_field') %></option>
          <% if (kept = builder.kept_field) %><option value="<%= kept %>" selected><%= t('.stored_field', name: kept) %></option><% end %>
          <% form.field_options.each do |col| %>
            <% col_label = pf_field_label_for(form.target_model, col.name) %>
            <option value="<%= col.name %>" <%= 'selected' if builder.field_selected?(col) %> data-pf-host-data><%= col_label.verbatim? ? col.name : "#{col_label.text} (#{col.name})" %><%= " — #{t('.ignored_field')}" if form.ignored_field?(col) %></option>
          <% end %>
        </select>
      </div>
      <% if builder.follow? %>
        <div class="pf-row">
          <label class="pf-fs-13 pf-text-2" for="pf-rule-follow">+ <%= t('.follow') %></label>
          <select id="pf-rule-follow" name="rule[path][]" class="pf-select pf-select--sm pf-select--auto" data-pf-refresh>
            <option value="" selected>—</option>
            <% builder.follow_options.each do |a| %><option value="<%= a.name %>" data-pf-host-data><%= pf_field_label_text(builder.target, a.name) %></option><% end %>
          </select>
          <button type="submit" formaction="<%= refresh %>" class="pf-btn pf-btn--xs" data-pf-js-hide><%= t('.update_form') %></button>
        </div>
      <% end %>
      <% if form.follows_relationship? %>
        <code class="pf-mono-key">field_accessor_path: <%= form.path.join('.') %></code>
      <% end %>
      <% if builder.model_missing? %><p class="pf-error" role="alert"><%= t('.model_missing') %></p><% end %>
    </div>

    <%# 3. Condition %>
    <div class="pf-stack">
      <span class="pf-label">3. <%= t('.condition') %></span>
      <div class="pf-condition">
        <label class="pf-sr-only" for="pf-rule-op"><%= t('.operator') %></label>
        <select id="pf-rule-op" name="rule[operator]" class="pf-select pf-select--auto" data-pf-refresh>
          <% form.operators.each do |op| %>
            <option value="<%= op %>" <%= 'selected' if builder.operator_selected?(op) %>><%= pf_operator_label(op) %></option>
          <% end %>
        </select>
        <button type="submit" formaction="<%= refresh %>" class="pf-btn pf-btn--xs" data-pf-js-hide><%= t('.update_form') %></button>
        <%= render 'value_input', form: form, invalid: errors[:value] %>
      </div>
      <% if form.nullable? %>
        <label class="pf-checkbox">
          <input type="checkbox" name="rule[include_nulls]" value="1" <%= 'checked' if form.include_nulls %>>
          <span><%= t('.include_nulls', field: form.column&.label || t('.this_field')) %></span>
        </label>
      <% end %>
    </div>

    <%# 4. Blocked message %>
    <div class="pf-field">
      <label class="pf-label" for="pf-rule-msg">4. <%= t('.message') %> <span class="pf-fs-12 pf-text-3 pf-fw-500"><%= t('.optional') %></span></label>
      <textarea id="pf-rule-msg" class="pf-textarea" name="rule[failure_message]" rows="2" aria-describedby="pf-rule-msg-help"><%= form.failure_message %></textarea>
      <p id="pf-rule-msg-help" class="pf-hint"><%= t('.message_help') %></p>
    </div>

    <%# Advanced %>
    <details class="pf-panel" <%= 'open' if builder.advanced_open? %>>
      <summary class="pf-fw-600"><%= t('.advanced') %> <span class="pf-fs-12 pf-text-3 pf-fw-500"><%= t('.advanced_hint') %></span></summary>
      <div class="pf-stack pf-mt-12">
        <div class="pf-choices" role="radiogroup" aria-label="<%= t('.join') %>">
          <% builder.join_choices.each do |choice| %>
            <label class="pf-choice">
              <input type="radio" name="rule[join]" value="<%= choice.join %>" <%= 'checked' if choice.checked %>>
              <span class="pf-choice__box">
                <span class="pf-choice__title"><%= t(".joins.#{choice.join}.title") %></span>
                <span class="pf-choice__desc"><%= choice.auto? ? t('.joins.auto.desc', choice: t(".joins.#{choice.auto}.title")) : t(".joins.#{choice.join}.desc") %></span>
              </span>
            </label>
          <% end %>
        </div>
        <span class="pf-hint"><%= t('.join_note') %></span>
        <label class="pf-checkbox">
          <input type="hidden" name="rule[is_active]" value="0">
          <input type="checkbox" name="rule[is_active]" value="1" <%= 'checked' if form.is_active %>>
          <span><%= t('.active') %></span>
        </label>
      </div>
    </details>

    <p class="pf-fs-13 pf-text-2">
      <%= builder.scoping_on? ? t('permission_forge.resources.rules_tab.scoping_on') : t('permission_forge.resources.rules_tab.scoping_off') %>
      <%= pf_setting_link('auto_query_scoping', t('permission_forge.ui.setting')) %>
    </p>

    <%# The sentence the saved rule shows (SentencesHelper). As the value, "the current user" or "or empty"
        change, pf_admin.js fetches it again from the preview action (one string, one helper); without JS
        it changes on the builder's refresh and on save. %>
    <div class="pf-panel pf-panel--muted pf-stack pf-stack--tight" aria-live="polite"
         data-pf-rule-preview="<%= permission_forge.preview_permission_set_resource_rules_path(set, resource.name) %>">
      <%= render 'preview', form: form, resource: resource %>
    </div>
    <%= render 'permission_forge/shared/reason_field', id: 'pf-rule-reason', value: params[:reason] %>
  <% end %>
<% end %>
