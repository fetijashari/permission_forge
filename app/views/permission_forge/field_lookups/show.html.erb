<% content_for :pf_title, t('permission_forge.ui.field_lookup') %>
<%= pf_sheet_frame({ title: t('permission_forge.ui.field_lookup'), close_path: permission_forge.root_path }) do %>
  <p class="pf-fs-13 pf-text-2"><%= t('.intro') %></p>
  <%= form_with url: permission_forge.field_lookup_path, method: :get, class: 'pf-form-grid' do %>
    <div class="pf-field">
      <label class="pf-label" for="pf-lookup-resource"><%= t('permission_forge.ui.resource') %></label>
      <select id="pf-lookup-resource" name="resource" class="pf-select" data-pf-autosubmit>
        <option value=""><%= t('.pick_resource') %></option>
        <% @resource_names.each do |name| %>
          <option value="<%= name %>" <%= 'selected' if name == @resource_name %> data-pf-host-data><%= pf_resource_label(name) %> (<%= name %>)</option>
        <% end %>
      </select>
    </div>
    <div class="pf-field">
      <label class="pf-label" for="pf-lookup-field"><%= t('.field') %></label>
      <select id="pf-lookup-field" name="field" class="pf-select" data-pf-autosubmit <%= 'disabled' unless @resource_name %>>
        <option value=""><%= t('.pick_field') %></option>
        <% @field_options.each do |name, label| %>
          <option value="<%= name %>" <%= 'selected' if name == @field %> data-pf-host-data><%= label %> (<%= name %>)</option>
        <% end %>
      </select>
    </div>
    <div><button type="submit" class="pf-btn pf-btn--sm" data-pf-js-hide><%= t('permission_forge.ui.apply') %></button></div>
  <% end %>
  <% if @resource_names.empty? %>
    <p class="pf-fs-13 pf-text-3"><%= t('.no_resources') %></p>
  <% elsif @field %>
    <%= pf_section_heading(t('.who_can_see', field: @field_label)) %>
    <%= render 'permission_forge/shared/across_sets', rows: @rows, key: @field %>
    <p class="pf-hint"><%= t('.hint') %></p>
  <% end %>
<% end %>
