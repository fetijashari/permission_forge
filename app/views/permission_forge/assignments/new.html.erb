<% content_for :pf_title, t('.title') %>
<% errors = @errors || {} %>
<% title = if @person then t('.title_person', name: pf_person_name(@person))
           elsif @preset_set then t('.title_set', set: pf_record_name(@preset_set))
           else t('.title') end %>
<% close_path = pf_back_or(@person ? permission_forge.person_path(@person) : permission_forge.people_path) %>
<%= form_with url: permission_forge.assignments_path, method: :post, id: 'pf-assign-form' do %>
  <input type="hidden" name="return_to" value="<%= params[:return_to] %>">
  <% footer = capture do %>
    <span class="pf-sheet__footer-note">
      <% if errors.any? %>
        <% errors.each_value do |msg| %><span class="pf-error" role="alert"><%= msg %></span> <% end %>
      <% elsif @person && @chosen_sets.any? %>
        <%= t('.summary', name: pf_person_name(@person), sets: pf_to_sentence(@chosen_sets.map(&:name)),
                          until: (@expiry == 'never' ? t('.forever') : t('.until', date: pf_expiry_preset_date(@expiry) || @custom_date))) %>
      <% else %>
        <%= t('.applies_now') %>
      <% end %>
    </span>
    <%= link_to t('permission_forge.ui.cancel'), close_path, class: 'pf-btn', data: { pf_close: true } %>
    <button type="submit" class="pf-btn pf-btn--primary">
      <%= @chosen_sets.size > 1 ? t('.assign_many', count: @chosen_sets.size) : t('.assign') %>
    </button>
  <% end %>

  <%= pf_sheet_frame({ title: title, close_path: close_path, footer: footer }) do %>
    <%# 1. Person %>
    <section class="pf-stack" aria-labelledby="pf-assign-person">
      <%= pf_section_heading("1. #{t('.person')}", id: 'pf-assign-person') %>
      <% if @person %>
        <input type="hidden" name="user_id" value="<%= @person.id %>">
        <div class="pf-picked">
          <%= pf_person_cell(@person) %>
          <button type="submit" class="pf-btn pf-btn--xs pf-ml-auto" formmethod="get" formaction="<%= permission_forge.new_assignment_path %>"
                  name="change_person" value="1"><%= t('.change') %></button>
        </div>
      <% else %>
        <div class="pf-row pf-row--nowrap">
          <label class="pf-sr-only" for="pf-assign-q"><%= t('permission_forge.ui.search_people') %></label>
          <input id="pf-assign-q" class="pf-input" type="search" name="q" value="<%= @query %>" autocomplete="off" autofocus
                 placeholder="<%= t('permission_forge.ui.search_people') %>"
                 data-pf-live="pf-assign-people" data-pf-live-url="<%= permission_forge.new_assignment_path %>">
          <button type="submit" class="pf-btn pf-btn--sm" formmethod="get" formaction="<%= permission_forge.new_assignment_path %>" name="search" value="1"><%= t('permission_forge.ui.search') %></button>
        </div>
        <div id="pf-assign-people">
          <%= render 'person_options', page: @people, query: @query, field: 'user_id', type: 'radio', invalid: errors[:person] %>
        </div>
      <% end %>
    </section>

    <%# 2. Permission Sets %>
    <section class="pf-stack" aria-labelledby="pf-assign-sets">
      <%= pf_section_heading("2. #{t('permission_forge.nav.permission_sets')}", id: 'pf-assign-sets') %>
      <div class="pf-row pf-row--nowrap">
        <label class="pf-sr-only" for="pf-assign-set-q"><%= t('.filter_sets') %></label>
        <input id="pf-assign-set-q" class="pf-input pf-input--sm" type="search" name="set_q" value="<%= @set_query %>"
               placeholder="<%= t('.filter_sets') %>" data-pf-live="pf-assign-set-list" data-pf-live-url="<%= permission_forge.new_assignment_path %>">
      </div>
      <div id="pf-assign-set-list" class="pf-listbox">
        <div class="pf-listbox__scroll" role="group" aria-label="<%= t('permission_forge.nav.permission_sets') %>">
          <% if @sets.empty? %>
            <p class="pf-option pf-text-3"><%= t('.no_sets') %></p>
          <% end %>
          <% @sets.each do |set| %>
            <% has = @existing_ids.include?(set.id) %>
            <%# A locked set that would widen access by taking a holder is shown, but cannot be picked. %>
            <% locked = !has && @locked_ids.include?(set.id) %>
            <label class="pf-option">
              <input type="checkbox" name="set_ids[]" value="<%= set.id %>" <%= 'checked' if @selected_ids.include?(set.id) && !has && !locked %> <%= 'disabled' if has || locked %>>
              <span class="pf-option__main">
                <span class="pf-row pf-row--tight">
                  <span class="pf-fw-600"><%= pf_record_name(set) %></span>
                  <% if has %><%= pf_badge(t('.already')) %><% end %>
                  <% if locked %><%= pf_lock_badge %><% end %>
                  <% if set.is_muting %><%= pf_badge("⊘ #{t('permission_forge.ui.badges.muting')}", variant: :muting) %><% end %>
                  <% unless set.is_active %><%= pf_off_badge %><% end %>
                </span>
                <% if set.description.present? %><span class="pf-fs-12 pf-text-3" data-pf-host-data><%= set.description %></span><% end %>
                <% if locked %><span class="pf-fs-12 pf-text-3"><%= t('.locked_hint') %></span><% end %>
              </span>
              <span class="pf-option__aside"><%= pf_people_text(@people_counts.fetch(set.id, 0)) %></span>
            </label>
          <% end %>
        </div>
      </div>
      <% muting = @chosen_sets.select(&:is_muting) %>
      <% if muting.any? %>
        <div class="pf-banner pf-banner--muting">
          <span class="pf-banner__glyph" aria-hidden="true">⊘</span>
          <div class="pf-banner__body"><span><%= t('.muting_notice', sets: pf_to_sentence(muting.map(&:name)), name: @person ? pf_person(@person).first_name : t('.this_person')) %></span></div>
        </div>
      <% end %>
    </section>

    <%# 3. Expiry %>
    <section class="pf-stack" aria-labelledby="pf-assign-expiry">
      <%= pf_section_heading("3. #{t('.expires')}", id: 'pf-assign-expiry') %>
      <%= render 'permission_forge/shared/expiry_picker', selected: @expiry, custom_date: @custom_date, error: errors[:expiry] %>
    </section>

    <%= render 'permission_forge/shared/reason_field', value: params[:reason] %>
  <% end %>
<% end %>
