<% outcome = explain[:field] %>
<% name = pf_person(explain[:user]).first_name %>
<div class="pf-panel pf-panel--muted pf-stack pf-stack--tight pf-fs-13" aria-live="polite">
  <% if outcome.nil? %>
    <span><%= t('.no_access', name: name, resources: pf_resource_plural(resource.name)) %></span>
  <% else %>
    <div><%= pf_effective_field_badge(outcome) %></div>
    <span>
      <% if outcome.blocked_by.any? %>
        <%= t('.muted', name: name, sets: pf_to_sentence(outcome.blocked_by.map(&:name))) %>
      <% elsif outcome.unconfigured %>
        <%= t('.unconfigured', name: name) %>
      <% elsif outcome.granted_by.any? %>
        <%= t('.granted', name: name, sets: pf_to_sentence(outcome.granted_by.map(&:name))) %>
      <% elsif outcome.implicit %>
        <%= t('.virtual_default', name: name) %>
      <% else %>
        <%= t('.none', name: name) %>
      <% end %>
      <%= t('.capped') if outcome.capped %>
    </span>
    <%# The entry that decides an inherited field, worded as the Why panel words it. %>
    <% if (chain = pf_field_chain_reason(outcome)) %>
      <span><span aria-hidden="true"><%= chain.first %></span> <%= chain.last %></span>
    <% end %>
    <%= link_to t('.full_picture', name: name), permission_forge.person_path(explain[:user], tab: 'effective', why: "#{resource.name}.field.#{outcome.name}", open: [resource.name]), class: 'pf-fs-12' %>
  <% end %>
</div>
