<% items = @attention.ending_soon %>
<section class="pf-card" aria-labelledby="pf-card-ending">
  <div class="pf-card__header">
    <div class="pf-stack pf-stack--tight pf-grow">
      <div class="pf-row">
        <h2 class="pf-h2" id="pf-card-ending"><%= t('.title') %></h2>
        <span class="pf-count-pill pf-count-pill--warn"><%= items.size %></span>
      </div>
      <p class="pf-card__desc"><%= t('.description') %></p>
    </div>
  </div>
  <% items.each do |assignment| %>
    <div class="pf-card__row pf-card__row--top">
      <div class="pf-stack pf-stack--tight pf-grow">
        <div class="pf-row pf-row--tight">
          <%= link_to pf_person_name(assignment.user), permission_forge.person_path(assignment.user_id), class: 'pf-fw-600' %>
          <%= pf_set_chip(assignment.permission_set) %>
        </div>
        <span class="pf-fs-13"><%= pf_expiry_tag(assignment.expires_at) %></span>
      </div>
      <div class="pf-actions">
        <%= form_with url: permission_forge.assignment_path(assignment), method: :patch, class: 'pf-reason-form' do %>
          <input type="hidden" name="expiry" value="extend30">
          <input type="hidden" name="return_to" value="<%= permission_forge.root_path %>">
          <button type="submit" class="pf-btn pf-btn--sm"><%= t('.extend') %></button>
          <%= render 'permission_forge/shared/reason_field', compact: true, id: "pf-extend-reason-#{assignment.id}" %>
        <% end %>
        <%= link_to t('permission_forge.ui.open_person'), permission_forge.person_path(assignment.user_id), class: 'pf-btn pf-btn--ghost' %>
      </div>
    </div>
  <% end %>
</section>
