<% items = @attention.secret_rules %>
<section class="pf-card" aria-labelledby="pf-card-secret-rules">
  <div class="pf-card__header">
    <div class="pf-stack pf-stack--tight pf-grow">
      <div class="pf-row">
        <span class="pf-text-warn" aria-hidden="true">⚠</span>
        <h2 class="pf-h2" id="pf-card-secret-rules"><%= t('.title') %></h2>
        <span class="pf-count-pill pf-count-pill--warn"><%= items.size %></span>
      </div>
      <p class="pf-card__desc"><%= t('.description') %></p>
    </div>
  </div>
  <% items.each do |item| %>
    <% set = item.permission_set %>
    <% resource = item.resource %>
    <div class="pf-card__row pf-card__row--top">
      <div class="pf-stack pf-stack--tight pf-grow">
        <div class="pf-row pf-row--tight">
          <strong><%= t('.rule', rule: pf_record_name(item.rule), resource: pf_resource_label(resource), set: pf_record_name(set)) %></strong>
          <%= pf_lock_badge if item.locked? %>
        </div>
        <span class="pf-fs-13 pf-text-2"><%= t('.column_html', column: content_tag(:code, item.rule.field_name.to_s)) %></span>
        <span class="pf-fs-13 pf-text-2"><%= t('.people', count: item.people_count) %></span>
      </div>
      <% if item.locked? %>
        <%= link_to t('.open'), permission_forge.permission_set_resource_path(set, resource.name, tab: 'rules'), class: 'pf-btn pf-btn--ghost' %>
      <% else %>
        <%= pf_modal_link t('.fix'), permission_forge.edit_permission_set_resource_rule_path(set, resource.name, item.rule),
                          kind: 'drawer', class: 'pf-btn pf-btn--sm' %>
      <% end %>
    </div>
  <% end %>
</section>
