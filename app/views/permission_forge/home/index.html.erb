<% content_for :pf_title, t('.title') %>
<div class="pf-page-header">
  <div class="pf-page-header__text">
    <h1 class="pf-h1"><%= t('.title') %></h1>
    <p class="pf-subtitle">
      <%= t('.subtitle', things: t('.things', count: @attention.total),
                         people: t('.people', count: @people_with_access),
                         sets: t('.sets', count: @active_sets)) %>
    </p>
  </div>
  <%= pf_modal_link t('permission_forge.ui.assign_set'), permission_forge.new_assignment_path, kind: 'drawer', class: 'pf-btn pf-btn--primary' %>
</div>

<div class="pf-toolbar">
  <%= form_with url: permission_forge.people_path, method: :get, class: 'pf-search-field', role: 'search' do %>
    <label class="pf-sr-only" for="pf-home-q"><%= t('.lookup') %></label>
    <svg class="pf-search-field__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
         aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3 3"/></svg>
    <input id="pf-home-q" class="pf-input pf-search-field__input" type="search" name="q" autocomplete="off"
           placeholder="<%= t('.search_placeholder') %>" aria-describedby="pf-home-q-help">
  <% end %>
  <%= pf_modal_link t('permission_forge.ui.field_lookup'), permission_forge.field_lookup_path, kind: 'drawer',
                    class: 'pf-btn', title: t('.field_lookup_title') %>
  <p id="pf-home-q-help" class="pf-hint pf-toolbar__help"><%= t('.search_help') %></p>
</div>

<% if @first_run %>
  <section class="pf-card" aria-labelledby="pf-first-run">
    <div class="pf-card__body pf-stack pf-stack--loose">
      <div class="pf-stack pf-stack--tight">
        <h2 class="pf-h2" id="pf-first-run"><%= t('.first_run.title') %></h2>
        <p class="pf-card__desc"><%= t('.first_run.body') %></p>
      </div>
      <ol class="pf-steps">
        <% %w[create add assign].each_with_index do |step, i| %>
          <li class="pf-step">
            <span class="pf-step__num" aria-hidden="true"><%= i + 1 %></span>
            <strong><%= t(".first_run.steps.#{step}.title") %></strong>
            <span class="pf-fs-13 pf-text-2"><%= t(".first_run.steps.#{step}.body") %></span>
          </li>
        <% end %>
      </ol>
      <div>
        <%= pf_modal_link t('.first_run.cta'), permission_forge.new_permission_set_path, class: 'pf-btn pf-btn--primary' %>
      </div>
    </div>
  </section>
<% elsif @attention.all_good? %>
  <section class="pf-card">
    <div class="pf-all-good">
      <span class="pf-all-good__icon" aria-hidden="true">✓</span>
      <h2 class="pf-h2"><%= t('.all_good.title') %></h2>
      <p class="pf-card__desc"><%= t('.all_good.body', days: @attention.stale_days) %></p>
    </div>
  </section>
<% else %>
  <%# Two independent stacks (no shared grid rows), so a tall card never leaves
      a gap in the other column. Cards alternate in priority order. %>
  <% cards = { 'audit_card' => @attention.audit_findings, 'broken_rules_card' => @attention.broken_rules,
               'privacy_card' => @attention.privacy_findings, 'rules_card' => @attention.unenforced_rules,
               'ending_card' => @attention.ending_soon,
               'expired_card' => @attention.expired, 'stale_card' => @attention.stale,
               'tidy_card' => @attention.tidy }.select { |_, items| items.any? }.keys %>
  <div class="pf-masonry">
    <% cards.partition.with_index { |_, i| i.even? }.reject(&:empty?).each do |column| %>
      <div class="pf-masonry__col">
        <% column.each do |card| %><%= render card %><% end %>
      </div>
    <% end %>
  </div>
<% end %>
