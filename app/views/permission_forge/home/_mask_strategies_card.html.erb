<% items = @attention.unknown_mask_strategies %>
<section class="pf-card" aria-labelledby="pf-card-mask-strategies">
  <div class="pf-card__header">
    <div class="pf-stack pf-stack--tight pf-grow">
      <div class="pf-row">
        <span class="pf-text-warn" aria-hidden="true">⚠</span>
        <h2 class="pf-h2" id="pf-card-mask-strategies"><%= t('.title') %></h2>
        <span class="pf-count-pill pf-count-pill--warn"><%= items.size %></span>
      </div>
      <p class="pf-card__desc"><%= t('.description') %></p>
    </div>
  </div>
  <% items.each do |item| %>
    <% field = item.field %>
    <% set = item.permission_set %>
    <div class="pf-card__row pf-card__row--top">
      <div class="pf-stack pf-stack--tight pf-grow">
        <strong><%= t('.field', field: pf_field_label_text(item.resource.name, field.name), resource: pf_resource_label(item.resource), set: set.name) %></strong>
        <%# The stored name is shown as written: it names no strategy, so it has no label. %>
        <span class="pf-fs-13 pf-text-2"><%= t('.strategy_html', strategy: content_tag(:code, field.mask_strategy.to_s)) %></span>
        <span class="pf-fs-13 pf-text-2"><%= t('.people', count: item.people_count) %></span>
      </div>
      <%= pf_modal_link t('.fix'), permission_forge.permission_set_resource_field_path(set, item.resource.name, field.name),
                        kind: 'drawer', class: 'pf-btn pf-btn--sm' %>
    </div>
  <% end %>
</section>
