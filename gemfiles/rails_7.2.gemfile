# frozen_string_literal: true

# Pins Rails to the 7.2.x line so CI's matrix.rails cells actually test that
# version. Selected in CI via BUNDLE_GEMFILE. Inherits everything else (dev/test
# gems + the gemspec runtime deps) from the root Gemfile.
eval_gemfile File.expand_path('../Gemfile', __dir__)

gem 'rails', '~> 7.2.0'

# json 3.0 removed the `quirks_mode` option that ActiveSupport < 8.1 still
# passes to JSON.generate (ArgumentError: unknown keyword: quirks_mode).
gem 'json', '< 3'
