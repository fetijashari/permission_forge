  def tenant_key_type
<% if tenant_column %>    key_type_of(:<%= table_prefix %>permission_sets, :<%= tenant_column %>)
<% else %>    :bigint
<% end %>  end

  def key_type_of(table, column)
    existing = table_exists?(table) && connection.columns(table).find { |c| c.name == column.to_s }
    existing ? existing.sql_type : :bigint
  end

  def add_column_once(table, column, type)
    add_column table, column, type unless column_exists?(table, column)
  end

  def add_index_once(table, columns, **options)
    add_index table, columns, **options unless index_name_exists?(table, options[:name])
  end
end
