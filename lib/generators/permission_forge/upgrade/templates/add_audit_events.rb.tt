  # install already owned these objects, so a rollback must never delete it.
  def down
    raise ActiveRecord::IrreversibleMigration,
          'The audit log is evidence: permission_forge_add_audit_events does not drop the audit_events table ' \
          'or its columns on rollback. Remove them deliberately, by hand, if you really mean to.'
  end

  private

  # No foreign keys: events outlive the records they describe.
  def create_audit_events
    create_table :<%= table_prefix %>audit_events do |t|
      t.string   :uuid, null: false
      t.datetime :occurred_at, null: false, precision: 6
      t.string   :event, null: false
      t.string   :category, null: false
      t.string   :actor_type, null: false
      t.string   :actor_id
      t.string   :actor_label
      t.string   :source, null: false
      t.string   :record_type
      t.string   :record_id
      t.string   :record_uuid
      t.string   :record_label
      t.bigint   :permission_set_id
      t.string   :permission_set_uuid
      t.string   :subject_user_id
      t.text     :data
      t.string   :reason
      t.string   :request_id
      t.string   :ip
      t.string   :correlation_id
<% if tenant_column %>      t.column   :<%= tenant_column %>, tenant_key_type
<% end %>      t.datetime :created_at, null: false
    end
  end

  # A table made by an earlier run without tenancy gets the column before its index.
  def add_tenant_column
<% if tenant_column %>    add_column_once :<%= table_prefix %>audit_events, :<%= tenant_column %>, tenant_key_type
<% end %>  end

  def add_audit_indexes
    table = :<%= table_prefix %>audit_events
    add_index_once table, :uuid, unique: true, name: 'idx_pf_audit_uuid'
    add_index_once table, :occurred_at, name: 'idx_pf_audit_occurred'
    add_index_once table, %i[event occurred_at], name: 'idx_pf_audit_event'
    add_index_once table, %i[subject_user_id occurred_at], name: 'idx_pf_audit_subject'
    add_index_once table, %i[permission_set_id occurred_at], name: 'idx_pf_audit_pset'
    add_index_once table, %i[permission_set_uuid occurred_at], name: 'idx_pf_audit_pset_uuid'
    add_index_once table, %i[record_type record_id occurred_at], name: 'idx_pf_audit_record'
    add_index_once table, %i[actor_id occurred_at], name: 'idx_pf_audit_actor'
    add_index_once table, :correlation_id, name: 'idx_pf_audit_correlation'
<% if tenant_column %>    add_index_once table, :<%= tenant_column %>, name: 'idx_pf_audit_tenant'
<% end %>  end

