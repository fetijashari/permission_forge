    add_column_once :<%= table_prefix %>permission_set_users, :reviewed_by_id, user_key_type
    add_column_once :<%= table_prefix %>permission_set_users, :reason, :string
    add_column_once :<%= table_prefix %>permission_set_group_users, :reason, :string
    add_column_once :<%= table_prefix %>resource_fields, :sensitive_acknowledged_by_id, user_key_type
  end

